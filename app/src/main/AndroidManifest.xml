<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared by both builds (see the product flavors in build.gradle.kts): the phone screens, the set-top box remote
    and updates. Everything for the TV (tuner, recordings, HbbTV, servers, colour keys) is in src/tv.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Installing app updates downloaded from the GitHub releases (UpdateChecker). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Internet channels; the set-top box remote; update checks. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Phone remote: finds boxes on the network and pairs with them; the pilot page is shown in PilotActivity. -->
        <activity
            android:name=".RemoteActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/PhoneTheme" />

        <activity
            android:name=".PilotActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/PhoneTheme" />

        <!-- The phone app (touch list of internet channels). Phones start here; on TV the launcher starts MainActivity. -->
        <activity
            android:name=".PhoneActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/PhoneTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone: adding channels from a playlist (with a check first) and organising them. -->
        <activity
            android:name=".PhoneImportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/PhoneTheme"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PhoneChannelsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/PhoneTheme" />

        <!-- Installation results and the restart after an update; the TV build adds BOOT_COMPLETED. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
