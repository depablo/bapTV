<?xml version="1.0" encoding="utf-8"?>
<!--
    Trust anchors: the system ones plus Certum Trusted Root CA (2018, valid until 2043), a public root that
    newer Android versions and browsers trust but older set-top boxes (Android 11) do not know. Some internet
    channel servers already use certificates under it. SHA-256 fingerprint of res/raw/certum_trusted_root_ca.pem:
    FE:76:96:57:38:55:77:3E:37:A9:5E:7A:D4:D9:CC:96:C3:01:57:C1:5D:31:76:5B:A9:B1:57:04:E1:AE:78:FD
    Plain HTTP stays allowed (local network servers, many stream servers).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/certum_trusted_root_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
