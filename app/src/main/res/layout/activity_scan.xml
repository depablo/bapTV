<?xml version="1.0" encoding="utf-8"?>
<!-- Channel search: one sentence, one main action and a progress line. Tuner options, other methods and
     diagnostics are under "Advanced settings"; tuner state and scan events go only to the log. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14">

    <LinearLayout
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_title"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scan_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/scan_methods"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scan_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_method_service" />

            <Button
                android:id="@+id/scan_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/scan_close" />

            <Button
                android:id="@+id/scan_advanced_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/scan_advanced_show" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scan_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/scan_options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/scan_vhf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/scan_include_vhf"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/scan_t2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/scan_dvbt2"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/scan_lna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_lna"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/scan_direct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_method_direct" />

                <Button
                    android:id="@+id/scan_setup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/scan_method_setup" />

                <Button
                    android:id="@+id/scan_diag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/menu_diagnostics" />
            </LinearLayout>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/scan_progress"
            style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <Button
            android:id="@+id/scan_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/scan_cancel"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Not shown: kept so the screen can still read the tuner state and scan events for the log. -->
    <TextView
        android:id="@+id/scan_frontend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/scan_log"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</FrameLayout>
