<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F14"
    android:orientation="vertical">

    <include layout="@layout/phone_header" />

    <TextView
        android:id="@+id/remote_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:text="@string/remote_searching"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <ListView
        android:id="@+id/remote_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:layout_weight="1"
        android:background="@drawable/panel_bg"
        android:divider="#14FFFFFF"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/remote_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/remote_scan" />

    <TextView
        android:id="@+id/remote_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:text="@string/remote_empty"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />
</LinearLayout>
