<?xml version="1.0" encoding="utf-8"?>
<!-- Menu-styled dialog (TvDialog): title, optional message, text field, list and buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/menu_panel_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- QR code with a link (TvDialog.qr). -->
    <ImageView
        android:id="@+id/tv_dialog_qr"
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_dialog_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingBottom="8dp"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/tv_dialog_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/menu_input_bg"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHighlight="#803D8BFD"
        android:textSize="18sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/tv_dialog_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null"
        android:dividerHeight="2dp"
        android:listSelector="@drawable/menu_item_focused"
        android:scrollbars="none"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tv_dialog_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/tv_dialog_cancel"
            style="@style/MenuButton"
            android:layout_marginEnd="10dp"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/tv_dialog_ok"
            style="@style/MenuButton"
            android:text="@android:string/ok" />
    </LinearLayout>
</LinearLayout>
