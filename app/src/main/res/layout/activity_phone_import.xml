<?xml version="1.0" encoding="utf-8"?>
<!-- Adding channels from a playlist: check them first, keep the ones that work. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/phone_header" />

    <TextView
        android:id="@+id/import_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:text="@string/phone_add_loading"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/import_progress"
        style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:indeterminate="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/phone_search_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            android:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/import_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/phone_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <Button
                android:id="@+id/import_check"
                style="@style/PhoneChip"
                android:text="@string/import_check" />

            <Button
                android:id="@+id/import_select_working"
                style="@style/PhoneChip"
                android:text="@string/import_select_working" />

            <Button
                android:id="@+id/import_select_all"
                style="@style/PhoneChip"
                android:text="@string/import_select_all" />

            <Button
                android:id="@+id/import_select_none"
                style="@style/PhoneChip"
                android:text="@string/import_select_none" />
        </LinearLayout>
    </HorizontalScrollView>

    <ListView
        android:id="@+id/import_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="#14FFFFFF"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/import_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/phone_primary_bg"
        android:enabled="false"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="@string/import_add_none"
        android:textStyle="bold" />
</LinearLayout>
