<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:buttonStyle">@style/MenuButtonBase</item>
    </style>
    <!-- Default app button (theme): rounded, accent-colored focus – like in the menu and dialogs. -->
    <style name="MenuButtonBase" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/menu_button_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Phone screens: system bars stay (the player hides them in full screen), dark page in the brand colours. -->
    <style name="PhoneTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/phone_bg</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/phone_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:buttonStyle">@style/MenuButtonBase</item>
    </style>

    <!-- Icon button in the phone's top bar and rows. -->
    <style name="PhoneIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <!-- Small button in a row of actions on the phone (import screen). -->
    <style name="PhoneChip" parent="MenuButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Button in menu-styled dialogs (TvDialog). -->
    <style name="MenuButton" parent="MenuButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">120dp</item>
    </style>
</resources>
