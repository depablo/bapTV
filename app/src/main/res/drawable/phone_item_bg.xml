<?xml version="1.0" encoding="utf-8"?>
<!-- Phone list row: the TV's focus colour while the row is pressed, otherwise transparent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><color android:color="@color/item_focused" /></item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
