<?xml version="1.0" encoding="utf-8"?>
<!-- Button in menu-styled dialogs: focused – accent, otherwise a slightly lighter background. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/accent" /><corners android:radius="8dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/accent" /><corners android:radius="8dp" /></shape></item>
    <item><shape><solid android:color="#26FFFFFF" /><corners android:radius="8dp" /></shape></item>
</selector>
