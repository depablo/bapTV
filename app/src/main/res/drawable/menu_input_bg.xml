<?xml version="1.0" encoding="utf-8"?>
<!-- Text field in menu-styled dialogs: accent-colored outline when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#26FFFFFF" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="8dp" /></shape></item>
    <item><shape><solid android:color="#26FFFFFF" /><corners android:radius="8dp" /></shape></item>
</selector>
