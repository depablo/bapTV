<?xml version="1.0" encoding="utf-8"?>
<!-- Main action button on the phone: accent colour, greyed out while there is nothing to do. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#26FFFFFF" /><corners android:radius="12dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#FF2F6FD0" /><corners android:radius="12dp" /></shape></item>
    <item><shape><solid android:color="@color/accent" /><corners android:radius="12dp" /></shape></item>
</selector>
