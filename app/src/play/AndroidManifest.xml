<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Play distribution only (see the flavors in build.gradle.kts): no installing of APKs, no writing to shared
    storage (recordings are never deleted by the app), no accessibility service and no network debug server.
    Stream analysis still reads the probe recordings of the tuner input (READ_EXTERNAL_STORAGE stays).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- The Sagemcom middleware experiment (SagemcomStb) is a GitHub-build feature, like the codec class test. -->
    <uses-permission android:name="com.sagemcom.server.BIND_STB_SERVICE" tools:node="remove" />

    <application>
        <uses-library android:name="com.sagemcom.stb" tools:node="remove" />
        <service android:name=".ColourKeysService" tools:node="remove" />
        <service android:name=".DebugServerService" tools:node="remove" />
        <service android:name=".RecordingService" tools:node="remove" />
        <receiver android:name=".RecordingAlarmReceiver" tools:node="remove" />
    </application>
</manifest>
